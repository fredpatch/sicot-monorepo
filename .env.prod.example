# Production - lives at /opt/sicot/.env.prod on the VPS, NEVER in this repo.
# Copy this file there by hand and fill in real values.

# ── Image registry ─────────────────────────────────────────
# Lowercased GitHub owner/org - the deploy workflow keeps this in sync
# automatically, but set an initial value so `docker compose pull` works
# before the first automated deploy.
GHCR_OWNER=fredpatch
APP_VERSION=latest

# ── Database ───────────────────────────────────────────────
DB_USER=sicot_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=sicot_db

# ── Server ─────────────────────────────────────────────────
CORS_ORIGIN=https://www.PLACEHOLDER-DOMAIN.com

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_MINIMUM_32_CHARS_REFRESH
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP ───────────────────────────────────────────────────
SMTP_HOST=mail.anac.ga
SMTP_PORT=587
SMTP_USER=sicot@anac.ga
SMTP_PASS=CHANGE_ME
SMTP_FROM=SICOT <sicot@anac.ga>

# ── Traduction IA ──────────────────────────────────────────
DEEPL_ENABLED=false
DEEPL_API_KEY=

# ── Intégration Personnel ANAC (réseau Tailscale) ───────────
PERSONNEL_ANAC_BASE_URL=http://100.110.227.69:4005
PERSONNEL_ANAC_API_KEY=

# ── Gemini (rapports IA) ─────────────────────────────────────
# NE JAMAIS activer sans validation DG/RGPD - voir Notion Sprint 11.
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Sécurité ───────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
