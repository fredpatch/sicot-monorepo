# Local dev — Docker Compose (docker-compose.yml)
# Copy to .env (gitignored) and fill in real values.

# ── Database ───────────────────────────────────────────────
DB_USER=sicot_user
DB_PASSWORD=sicot_pass
DB_NAME=sicot_db

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARS_REFRESH

# ── SMTP (optional locally — OTP emails just log/fail without it) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SICOT <sicot@anac.ga>

# ── Traduction IA ──────────────────────────────────────────
DEEPL_ENABLED=false
DEEPL_API_KEY=

# ── Intégration Personnel ANAC (réseau Tailscale, optionnel en local) ──
PERSONNEL_ANAC_BASE_URL=
PERSONNEL_ANAC_API_KEY=

# ── Gemini (rapports IA — réservé environnement de test) ────
GEMINI_API_KEY=
GEMINI_MODEL=
